runs/
qualification/*.local.yaml
qualification/results/
qualification/assignments*.yaml
qualification/matrix_report.json
qualification/debug-overhead.json

# Legacy generated-data guards (current projects own these directories)
models/
profiles/

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Native/CMake build outputs
native/flir_gst_source/build/
native/**/*.o
native/**/*.so

# Virtual environments
.venv/

# Legacy DeepStream artifact paths
DeepStream-Yolo/artifacts/onnx/
