# Legacy repository-local data retained only as an accidental-commit guard;
# current runtime data belongs under an external SqueakView project.
runs/
qualification/*.local.yaml
qualification/results/
qualification/assignments*.yaml
qualification/matrix_report.json
qualification/debug-overhead.json

# Legacy generated-data guards (current projects own these directories)
models/
profiles/

# Python cache
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local planning and review notes are not product documentation.
/local-notes/
/docs/*_PLAN.md

# Native/CMake build outputs
native/flir_gst_source/build/
native/yolo26_pose_parser/build/
native/yolo26_pose_parser/build-comparison/
native/nvdsinfer_custom_impl_yolo/.build-config*
native/**/*.o
native/**/*.so
build/
dist/

# Virtual environments
.venv/

# Legacy DeepStream artifact paths
DeepStream-Yolo/artifacts/onnx/
DeepStream-Yolo/artifacts/weights/*.pt
!DeepStream-Yolo/artifacts/weights/yolo26s_dino_10kpts.pt
DeepStream-Yolo/engines/
DeepStream-Yolo/configs/*
!DeepStream-Yolo/configs/templates/
!DeepStream-Yolo/configs/templates/**
!DeepStream-Yolo/configs/inference_off.txt
!DeepStream-Yolo/configs/yolo26s_dino_10kpts_fp16.txt

# Local tools; keep the packaged command-line tools tracked.
tools/
!squeakview/tools/
!squeakview/tools/*.py
*.egg-info/

# local credentials / secrets
client_secret_*.json

# OS cruft
.DS_Store
