!DeepStream-Yolo/configs/templates/
!DeepStream-Yolo/configs/templates/**
!DeepStream-Yolo/configs/inference_off.txt
!DeepStream-Yolo/configs/yolo26s_dino_10kpts_fp16.txt

#tool omit
tools/
!squeakview/tools/
!squeakview/tools/*.py
*.egg-info/

# local credentials / secrets
client_secret_*.json

# OS cruft
.DS_Store
